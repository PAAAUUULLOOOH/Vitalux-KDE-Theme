[%General]
author=PAAAUUULLOOOH
comment=Liquid Glass for openSUSE / Plasma 6.8
respect_DE=true
composite=true
translucent_windows=true
blurring=true
popup_blurring=true
reduce_window_opacity=0
reduce_menu_opacity=0
animate_states=true
scroll_width=10
slider_width=5
slider_handle_width=18
slider_handle_length=18
menu_shadow_depth=16
tooltip_shadow_depth=12
menu_blur_radius=10
tooltip_blur_radius=10
contrast=0.85
intensity=1.05
saturation=1.1
opaque=haruna,vlc,kdenlive,obs,mpv
[GeneralColors]
window.color=#f2f5fa
base.color=#fdfeff
alt.base.color=#eaf0f8
button.color=#f7faff
light.color=#ffffff
mid.light.color=#edf2fa
dark.color=#9aaac0
mid.color=#c4d0df
highlight.color=#0068e0
inactive.highlight.color=#d7e6fc
text.color=#1d2028
window.text.color=#1d2028
button.text.color=#1d2028
disabled.text.color=#737d8d
highlight.text.color=#ffffff
tooltip.base.color=#f3f7fd
tooltip.text.color=#1d2028
link.color=#005ecd
link.visited.color=#6c40b1
[Hacks]
respect_darkness=true
[PanelButtonCommand]
frame=true
frame.element=button
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=button
text.normal.color=#1d2028
text.focus.color=#1d2028
text.press.color=#1d2028
text.toggle.color=#ffffff
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8
text.iconspacing=6
indicator.element=arrow
indicator.size=9
text.shadow=false

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=button
interior.element=button

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit

[ComboBox]
inherits=PanelButtonCommand
frame.element=button
interior.element=button

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu

[ToolTip]
inherits=PanelButtonCommand
frame.element=tooltip
interior.element=tooltip

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.focus.color=#ffffff
text.press.color=#ffffff

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.focus.color=#ffffff
text.press.color=#ffffff

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab

[GenericFrame]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[GroupBox]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[TabFrame]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[Toolbar]
inherits=PanelButtonCommand
frame.element=toolbar
interior.element=toolbar

[MenuBar]
inherits=PanelButtonCommand
frame.element=toolbar
interior.element=toolbar

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbar
interior.element=scrollbar
frame=false

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[Slider]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[SliderCursor]
inherits=PanelButtonCommand
frame.element=handle
interior.element=handle
frame=false

[Progressbar]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame=false

[Window]
interior=true
interior.element=window
[WindowTranslucent]
interior=true
interior.element=window-translucent

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
[RadioButton]
inherits=CheckBox
interior.element=radio
