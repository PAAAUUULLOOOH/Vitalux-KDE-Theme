<!DOCTYPE RCC><RCC version="1.0">
<qresource prefix="/effects/glass/">
  <file>generated/downsample.frag</file>
  <file>generated/noise.frag</file>
  <file>generated/onscreen_rounded.frag</file>
  <file>generated/onscreen_rounded.vert</file>
  <file>generated/upsample.frag</file>
  <file>generated/vertex.vert</file>
  <!-- KWin 6.6 asks for the _core name on a core profile context. -->
  <file alias="generated/downsample_core.frag">generated/downsample.frag</file>
  <file alias="generated/noise_core.frag">generated/noise.frag</file>
  <file alias="generated/onscreen_rounded_core.frag">generated/onscreen_rounded.frag</file>
  <file alias="generated/onscreen_rounded_core.vert">generated/onscreen_rounded.vert</file>
  <file alias="generated/upsample_core.frag">generated/upsample.frag</file>
  <file alias="generated/vertex_core.vert">generated/vertex.vert</file>
</qresource>
</RCC>
