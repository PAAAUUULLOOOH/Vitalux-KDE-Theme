[Icon Theme]
Name=Liquid Glass
Comment=Glass frames around the original locally installed application icons
Inherits=breeze,hicolor
Directories=scalable/apps,scalable/places,scalable/mimetypes
[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable
[scalable/places]
Size=64
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=512
Context=MimeTypes
Type=Scalable
