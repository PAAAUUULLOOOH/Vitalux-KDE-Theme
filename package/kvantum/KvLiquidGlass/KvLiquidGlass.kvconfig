[%General]
author=PAAAUUULLOOOH
comment=Original Vitalux Liquid Silver palette and smoked glass
respect_DE=true
composite=true
translucent_windows=true
blurring=true
popup_blurring=true
reduce_window_opacity=0
reduce_menu_opacity=0
animate_states=true
scroll_width=10
slider_width=5
slider_handle_width=18
slider_handle_length=18
menu_shadow_depth=16
tooltip_shadow_depth=12
menu_blur_radius=10
tooltip_blur_radius=10
contrast=1.0
intensity=1.0
saturation=1.0
opaque=haruna,vlc,kdenlive,obs,mpv

[GeneralColors]
window.color=#080b10
base.color=#0d1219
alt.base.color=#151b23
button.color=#252d36
light.color=#e3edf5
mid.light.color=#2a3543
dark.color=#080b10
mid.color=#73889c
highlight.color=#333b44
inactive.highlight.color=#2a3543
text.color=#edf2f7
window.text.color=#edf2f7
button.text.color=#edf2f7
disabled.text.color=#afbdc9
highlight.text.color=#edf2f7
tooltip.base.color=#151b23
tooltip.text.color=#edf2f7
link.color=#b9ccdc
link.visited.color=#e3edf5
progress.indicator.text.color=#080b10
progress.inactive.indicator.text.color=#080b10

[Hacks]
respect_darkness=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=button
text.normal.color=#edf2f7
text.focus.color=#edf2f7
text.press.color=#edf2f7
text.toggle.color=#080b10
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8
text.iconspacing=6
indicator.element=arrow
indicator.size=9
text.shadow=false

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=button
interior.element=button

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit

[ComboBox]
inherits=PanelButtonCommand
frame.element=button
interior.element=button

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu

[ToolTip]
inherits=PanelButtonCommand
frame.element=tooltip
interior.element=tooltip

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.focus.color=#edf2f7
text.press.color=#edf2f7

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.focus.color=#edf2f7
text.press.color=#edf2f7

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab

[GenericFrame]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[GroupBox]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[TabFrame]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[Toolbar]
inherits=PanelButtonCommand
frame.element=toolbar
interior.element=toolbar

[MenuBar]
inherits=PanelButtonCommand
frame.element=toolbar
interior.element=toolbar

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbar
interior.element=scrollbar
frame=false

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[Slider]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[SliderCursor]
inherits=PanelButtonCommand
frame.element=handle
interior.element=handle
frame=false

[Progressbar]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame=false
text.normal.color=#edf2f7

[Window]
interior=true
interior.element=window

[WindowTranslucent]
interior=true
interior.element=window-translucent

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.normal.color=#edf2f7

[RadioButton]
inherits=CheckBox
interior.element=radio
text.normal.color=#edf2f7
